# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fermi

# API Keys
OPENAI_API_KEY=sk-...
SERP_API_KEY=...

# Similarity Thresholds
SEED_SIMILARITY_THRESHOLD=0.1
QUESTION_SIMILARITY_THRESHOLD=0.15

# Pipeline Parameters
QUESTION_GENERATION_MODEL=gpt-4o-mini
QUESTION_GENERATION_MODEL_PROVIDER=openai

# Answer Parameters
LOCATION_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o
MODEL_PROVIDER=openai
CONFIDENCE_THRESHOLD=0.8
