// apps/fermi-api/firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if request.auth != null;

      match /questions/{questionId} {
        // Allow listing (queries) for authenticated users
        allow list: if request.auth != null;
        // Allow getting individual docs only when revealed
        allow get: if request.auth != null && resource.data.revealed == true;
      }

      match /answers/{answerId} {
        allow list: if request.auth != null;
        allow get: if request.auth != null && resource.data.revealed == true;
      }

      match /players_results/{playerAnswerId} {
        allow list: if request.auth != null;
        allow get: if request.auth != null && resource.data.revealed == true;
      }
    }

    // Daily Question documents - allow authenticated users to read for real-time status
    match /daily_questions/{date} {
      allow read: if request.auth != null;
    }

    // DeathMatch queue - players can only read/write their own entry
    match /dm_queue/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow delete: if request.auth != null && request.auth.uid == playerId;
    }

    // DeathMatch matches - participants can read their match
    match /dm_matches/{matchId} {
      allow read: if request.auth != null
        && (resource.data.player1.player_id == request.auth.uid
            || resource.data.player2.player_id == request.auth.uid);
    }
  }
}
