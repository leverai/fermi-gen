# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/fermi-db

# API Keys
CHOTTULINK_API_KEY=your_chottulink_key
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret
REVENUECAT_API_KEY=your_revenuecat_api_key

# Security
JWT_SECRET_KEY=your_jwt_secret_key

# Firebase (Local Emulators)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=fermi-local

# App Config
APP_ENV=local
USE_EMULATORS=true
