# Dashboard Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Database Configuration
# =============================================================================

# For local development with Cloud SQL Proxy:
DATABASE_URL="postgresql+asyncpg://postgres:<password>@127.0.0.1:5433/fermi-db"

# For deployed environments (Cloud Run):
# These are set via GCP Secret Manager, not .env file
# DATABASE_URL_DEV - Dev database connection string
# DATABASE_URL_PROD - Prod database connection string
# ENVIRONMENT - "dev" or "prod" to select which DB to use

# =============================================================================
# Authentication (optional for local dev, required for deployed)
# =============================================================================

# HTTP Basic Auth credentials
# If both are set, dashboard requires authentication
# AUTH_USERNAME=admin
# AUTH_PASSWORD=your-secure-password
